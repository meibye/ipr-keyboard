{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PowerShell Launch Current File",
      "type": "PowerShell",
      "request": "launch",
      "script": "${file}",
      "cwd": "${cwd}"
    },
    {
      "name": "PowerShell: Launch with Args",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/your_script.ps1",
      "args": ["param1", "param2"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "PowerShell: Attach",
      "type": "PowerShell",
      "request": "attach"
    },
    {
      "name": "Node.js: Launch MCP JS",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/your_js_entry.js",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Node.js: Attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true
    },
    {
      "name": "pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v", "--tb=long", "--no-header"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--tb=long", "-s"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: with coverage",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/", "-v", "--tb=short",
        "--cov=src/ipr_keyboard",
        "--cov-report=term-missing"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Flask: run dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "ipr_keyboard.web.server",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
