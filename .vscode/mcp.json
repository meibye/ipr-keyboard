{
  "servers": {
    "ipr-rpi-dev-ssh": {
      "command": "npx",
      "args": [
        "-y",
        "@fangjunjie/ssh-mcp-server",
        "--host",
        "ipr-dev-pi4",
        "--port",
        "22",
        "--username",
        "meibye",
        "--privateKey",
        "~/.ssh/id_ed25519_ipr_kb",
        "--blacklist",
        "^rm .*,^shutdown.*,^reboot.*"
      ]
    },
    "ipr-pc-dev-ssh": {
      "command": "npx",
      "args": [
        "-y",
        "@fangjunjie/ssh-mcp-server",
        "--host",
        "msi",
        "--port",
        "22",
        "--username",
        "micha",
        "--privateKey",
        "~/.ssh/id_ed25519_ipr_kb",
        "--blacklist",
        "^rm .*,^shutdown.*,^reboot.*,^del .*,^poweroff.*,^logoff.*,^shutdown /.*,^format .*"
      ]
    },
    "ipr-rpi-dev-ssh-debug": {
      "command": "node",
      "args": [
        "D:\\mcp\\ssh-mcp\\node_modules\\@fangjunjie\\ssh-mcp-server\\build\\index.js",
        "--host",
        "ipr-dev-pi4",
        "--port",
        "22",
        "--username",
        "meibye",
        "--privateKey",
        "~/.ssh/id_ed25519_ipr_kb",
        "--blacklist",
        "^rm .*,^shutdown.*,^reboot.*"
      ],
      "dev": {
        "debug": {
          "type": "node"
        }
      }
    },
    "ipr-pc-dev-ssh-debug": {
      "command": "node",
      "args": [
        "D:\\mcp\\ssh-mcp\\node_modules\\@fangjunjie\\ssh-mcp-server\\build\\index.js",
        "--host",
        "msi",
        "--port",
        "22",
        "--username",
        "micha",
        "--privateKey",
        "~/.ssh/id_ed25519_ipr_kb",
        "--blacklist",
        "^rm .*,^shutdown.*,^reboot.*,^del .*,^poweroff.*,^logoff.*,^shutdown /.*,^format .*"
      ],
      "dev": {
        "debug": {
          "type": "node"
        }
      }
    },
    "ipr-rpi-prod-zero2-ssh": {
      "command": "npx",
      "args": [
        "-y",
        "@fangjunjie/ssh-mcp-server",
        "--host",
        "ipr-prod-zero2",
        "--port",
        "22",
        "--username",
        "meibye",
        "--privateKey",
        "~/.ssh/ipr_rpi",
        "--blacklist",
        "^rm .*,^shutdown.*,^reboot.*"
      ]
    },
    "ipr-rpi-prod-zero-ssh": {
      "command": "npx",
      "args": [
        "-y",
        "@fangjunjie/ssh-mcp-server",
        "--host",
        "ipr-prod-zero",
        "--port",
        "22",
        "--username",
        "meibye",
        "--privateKey",
        "~/.ssh/ipr_rpi",
        "--blacklist",
        "^rm .*,^shutdown.*,^reboot.*"
      ]
    }
  }
