	(footprint "IprSense:LED_D5.0mm-4_RGB_ReverseMount_Perfboard"
		(layer "F.Cu")
		(uuid "dc9456fe-cbeb-446e-ae3c-c787166732b9")
		(at 153.03 84.93)
		(descr "5mm 4-lead RGB LED (R,K,G,B in line, 1.27mm pitch) inserted from the back through a 5.2mm hole so the dome is on the top side and the flange stays on the back; hole centred between four 2.54mm perfboard pads (which it removes). Outer leads R and B bend outward along the lead row (pads 1 and 4); inner leads K and G both bend sideways to the same side at different heights (pads 2 and 3) - sleeve one of them. 1=R 2=K 3=G 4=B")
