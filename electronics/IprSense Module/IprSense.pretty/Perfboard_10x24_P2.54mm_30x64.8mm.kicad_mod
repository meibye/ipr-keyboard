(footprint "Perfboard_10x24_P2.54mm_30x64.8mm"
  (version 20240108)
  (generator "konnect")
  (layer "F.Cu")
  (descr "Drawing overlay of a 30x64.8mm double-sided prototype board with 10x24 pads on 2.54mm pitch. Every pad is a plated-through hole: a pre-tinned copper ring on BOTH faces, joined by the plating in the hole, and isolated from every other pad. Each is drawn as a 2.0mm ring around a 1.0mm hole on F.Fab and B.Fab, so both views show solderable pads rather than bare holes. Rows A-J run bottom to top (A = lower-left corner, top view), columns 1-24 left to right; footprint origin is pad J1 (top-left). Corner pads A1/J1/A24/J24 are the 2.7mm mounting holes (NPTH here). The grid carries no copper in KiCad - the real rings are made by the board, not by this footprint, so tracks and component pads may sit on them freely. Usable area for parts: A3..J22")
  (attr board_only exclude_from_bom exclude_from_pos_files allow_missing_courtyard)
  (tags "perfboard prototype 2.54mm")
