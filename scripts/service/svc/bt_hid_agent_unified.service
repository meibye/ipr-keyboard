[Unit]
Description=IPR Keyboard BlueZ Pairing Agent (LE HOGP)
After=bluetooth.service
Requires=bluetooth.service
BindsTo=bluetooth.service
PartOf=bluetooth.service

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bt_hid_agent_unified

# Default first, so /opt/ipr_common.env can override it.  systemd expands
# ${BT_HCI} but NOT the shell form ${BT_HCI:-hci0} -- that is passed through
# literally, so every command below received the raw string as its adapter.
Environment=BT_HCI=hci0
EnvironmentFile=-/opt/ipr_common.env

# Prepare the adapter for LE-only HID over GATT — deterministically.
#
# bt_adapter_prepare.sh waits for bluetoothd to own and power the adapter
# (ControllerMode = le, AutoEnable = true in main.conf), then ENFORCES
# LE-only: if BR/EDR is still on it power-cycles the adapter to switch it
# off, because that setting is rejected while powered.  The previous
# sequence (`hciconfig up`, then a tolerated `bredr off`) powered the adapter
# dual-mode at boot and LE-only after restarts, and a PC bonded in one
# configuration would not reconnect in the other.
#
# btmgmt hangs without a terminal (bt_shell); the helper wraps every call in
# `script -qec` and `timeout`, and fails the unit with a clear message if the
# adapter cannot be made LE-only.
ExecStartPre=/usr/bin/timeout 60 /usr/local/bin/bt_adapter_prepare.sh ${BT_HCI}

ExecStart=/usr/bin/python3 -u /usr/local/bin/bt_hid_agent_unified.py --adapter ${BT_HCI}

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
